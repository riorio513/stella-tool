# ===== 必須 =====
# Discord Bot のトークン（Discord Developer Portal で取得）
DISCORD_BOT_TOKEN=ここにDiscordボットのトークン

# Google Gemini の API キー（https://aistudio.google.com/app/apikey で無料取得）
GEMINI_API_KEY=ここにGeminiのAPIキー

# ===== 任意（未指定なら下記の既定値）=====
# 回答生成に使うモデル。安さ最優先なら flash-lite 系があればそれでも可。
GEMINI_CHAT_MODEL=gemini-3.5-flash

# 埋め込み（ベクトル化）モデル
GEMINI_EMBED_MODEL=gemini-embedding-001

# 1チャンネルあたり取り込む過去メッセージの上限件数
HISTORY_LIMIT=2000

# 質問時に参照する関連メッセージ数（多いほど精度↑だがトークン↑）
TOP_K=8

# データ（SQLite）の保存先
DB_PATH=data/stella_bot.sqlite3
